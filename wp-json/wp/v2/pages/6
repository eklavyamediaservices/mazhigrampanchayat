0928\u0947 \u092e\u093e\u0902\u0921\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0906\u0939\u0947. \u092f\u093e \u092a\u094d\u0930\u0915\u0932\u094d\u092a\u093e\u091a\u094d\u092f\u093e \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0924\u0942\u0928 \u0917\u093e\u0935\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u091d\u093e\u0932\u0947\u0932\u094d\u092f\u093e \u0930\u0938\u094d\u0924\u0947, \u092a\u093e\u0923\u0940\u092a\u0941\u0930\u0935\u0920\u093e, \u0936\u093f\u0915\u094d\u0937\u0923, \u0906\u0930\u094b\u0917\u094d\u092f, \u0936\u0947\u0924\u0940 \u0906\u0923\u093f \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923 \u0938\u0902\u0935\u0930\u094d\u0927\u0928 \u092f\u093e\u0902\u0938\u093e\u0930\u0916\u094d\u092f\u093e \u0935\u093f\u0935\u093f\u0927 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0902\u0924\u0940\u0932 \u092a\u094d\u0930\u0917\u0924\u0940\u091a\u0947 \u0921\u0949\u0915\u094d\u092f\u0941\u092e\u0947\u0902\u091f\u0947\u0936\u0928 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u0947. <span style=\"font-style: inherit; font-weight: inherit;\">\u092f\u093e \u092a\u094d\u0932\u0945\u091f\u092b\u0949\u0930\u094d\u092e\u0935\u0930 \u0917\u094d\u0930\u093e\u092e\u092a\u0902\u091a\u093e\u092f\u0924\u0940\u0902\u0928\u0940 \u0936\u093e\u0938\u0915\u0940\u092f \u092f\u094b\u091c\u0928\u093e\u0902\u091a\u093e \u0915\u0947\u0932\u0947\u0932\u093e \u092f\u094b\u0917\u094d\u092f \u0935\u093e\u092a\u0930, \u092e\u0939\u093f\u0932\u093e\u0902\u0938\u093e\u0920\u0940 \u0930\u094b\u091c\u0917\u093e\u0930\u0928\u093f\u0930\u094d\u092e\u093f\u0924\u0940, \u0924\u0930\u0941\u0923\u093e\u0902\u0938\u093e\u0920\u0940 \u0915\u094c\u0936\u0932\u094d\u092f \u0935\u093f\u0915\u093e\u0938, \u0906\u0923\u093f \u0921\u093f\u091c\u093f\u091f\u0932 \u0917\u094d\u0930\u093e\u092e\u092a\u0902\u091a\u093e\u092f\u0924 \u0909\u092a\u0915\u094d\u0930\u092e \u092f\u093e\u0902\u0938\u093e\u0930\u0916\u094d\u092f\u093e \u0928\u0935\u0915\u0932\u094d\u092a\u0928\u093e\u0902\u0928\u093e \u0935\u093f\u0936\u0947\u0937 \u0938\u094d\u0925\u093e\u0928 \u0926\u093f\u0932\u0947 \u091c\u093e\u0924\u0947. \u0924\u0938\u0947\u091a, \u091c\u0932\u0938\u0902\u0927\u093e\u0930\u0923, \u0938\u0947\u0902\u0926\u094d\u0930\u093f\u092f \u0936\u0947\u0924\u0940 \u0906\u0923\u093f \u0939\u0935\u093e\u092e\u093e\u0928 \u092c\u0926\u0932\u093e\u0936\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0909\u092a\u093e\u092f\u092f\u094b\u091c\u0928\u093e\u0902\u0935\u0930\u0939\u0940 \u092d\u0930 \u0926\u093f\u0932\u093e \u091c\u093e\u0924\u094b.\u00a0<\/span><span style=\"font-style: inherit; font-weight: inherit;\">\u0917\u093e\u0935\u093e\u0902\u091a\u093e \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0935\u093e\u0930\u0938\u093e, \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u092a\u0930\u0902\u092a\u0930\u093e \u0906\u0923\u093f \u0928\u093f\u0938\u0930\u094d\u0917\u0930\u092e\u094d\u092f \u092a\u0930\u094d\u092f\u091f\u0928 \u0938\u094d\u0925\u0933\u0947 \u092f\u093e\u0902\u091a\u093e \u092a\u094d\u0930\u091a\u093e\u0930 \u0915\u0930\u0942\u0928 \u0917\u094d\u0930\u093e\u092e\u0940\u0923 \u092a\u0930\u094d\u092f\u091f\u0928\u093e\u0932\u093e \u091a\u093e\u0932\u0928\u093e \u0926\u0947\u0923\u0947 \u0939\u0947 \u0926\u0947\u0916\u0940\u0932 \u092f\u093e \u0909\u092a\u0915\u094d\u0930\u092e\u093e\u091a\u0947 \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0947 \u0909\u0926\u094d\u0926\u093f\u0937\u094d\u091f \u0906\u0939\u0947. YouTube, Instagram \u0906\u0923\u093f Facebook \u0938\u093e\u0930\u0916\u094d\u092f\u093e \u0921\u093f\u091c\u093f\u091f\u0932 \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947 \u092f\u093e \u092f\u0936\u094b\u0917\u093e\u0925\u093e \u0905\u0927\u093f\u0915\u093e\u0927\u093f\u0915 \u0932\u094b\u0915\u093e\u0902\u092a\u0930\u094d\u092f\u0902\u0924 \u092a\u094b\u0939\u094b\u091a\u0935\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u093e\u0924.\u00a0<\/span><span st